<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivStaffAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Nhân viên"
            android:src="@android:drawable/ic_menu_myplaces"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvStaffFullName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:text="Nhân Viên A"
            android:textColor="@color/on_surface_light"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnDeleteStaff"
            app:layout_constraintStart_toEndOf="@+id/ivStaffAvatar"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvStaffUsername"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tài khoản: nv1"
            android:textColor="@android:color/darker_gray"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@+id/btnDeleteStaff"
            app:layout_constraintStart_toStartOf="@+id/tvStaffFullName"
            app:layout_constraintTop_toBottomOf="@+id/tvStaffFullName" />

        <TextView
            android:id="@+id/tvStaffPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Mật khẩu: 123"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@+id/btnDeleteStaff"
            app:layout_constraintStart_toStartOf="@+id/tvStaffFullName"
            app:layout_constraintTop_toBottomOf="@+id/tvStaffUsername" />

        <ImageButton
            android:id="@+id/btnDeleteStaff"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Xóa nhân viên"
            android:src="@android:drawable/ic_menu_delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
